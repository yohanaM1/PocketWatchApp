# Copy to .env and adjust. Used by docker-compose.yml and the backend.
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=pocketwatch
MYSQL_USER=pocketwatch
MYSQL_PASSWORD=pocketwatch
MYSQL_PORT=3306

# Demo login for `python -m scripts.seed_demo_user` (8+ character password). Kept here because .env is never
# committed; on a deployment, use a strong password and share it with the graders as the test account.
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=

# For host runs (uvicorn/alembic/pytest). `docker compose up` sets its own URL pointing at the db container.
DATABASE_URL=mysql+pymysql://pocketwatch:pocketwatch@127.0.0.1:3306/pocketwatch

# Port for the full app with `docker compose up` (http://localhost:8080).
WEB_PORT=8080

# Auth: use a long random value, e.g. `python3 -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=1440

# Tests create and wipe this database (root is needed to create it).
TEST_DATABASE_URL=mysql+pymysql://root:rootpass@127.0.0.1:3306/pocketwatch_test

# Agent LLM (OpenAI-compatible /chat/completions). Leave empty in CI; questions then end as `failed`.
# Run `python -m scripts.check_llm` from backend/ once to find the right LLM_TOOL_CHOICE / LLM_TEMPERATURE.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TOOL_CHOICE=required
LLM_TEMPERATURE=0
AGENT_EXPLORATION=false

# Review queue: LLM category guesses below this confidence go to /review. 0.75 comes from the Nov 11 categorization
# evaluation (see README, Review queue); re-run scripts.eval_categorization before changing it.
REVIEW_CONFIDENCE_THRESHOLD=0.75

# Anomaly flags: a charge this many times the merchant's usual (or the category's, when the merchant has few
# charges) is "unusually large"; a first-time merchant at least this many dollars is a "new merchant".
ANOMALY_LARGE_MULTIPLE=5
ANOMALY_LARGE_CATEGORY_MULTIPLE=8
ANOMALY_UNFAMILIAR_MIN=75

BUDGET_NEAR_FRACTION=0.8  # a budget shows "near" once spending reaches this fraction of the limit

